# Environment variables for FusionScope backend
# Copy to .env and adjust as needed

# Database
DATABASE_URL=sqlite:///./fusionscope.db

# Debug mode
DEBUG=False

# API Configuration
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated frontend origins)
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# Shared secret for POST /api/refresh (endpoint returns 503 until set)
# REFRESH_TOKEN=change-me

# Optional: approved ReliefWeb appname (https://apidoc.reliefweb.int)
# enables real humanitarian report headlines in the feed
# RELIEFWEB_APPNAME=
